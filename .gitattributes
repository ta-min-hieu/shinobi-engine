# Chuẩn hoá line ending — dev Windows, CI Linux (GIT-WORKFLOW.md §8)
* text=auto eol=lf

# Script Windows giữ CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Gradle wrapper script
gradlew     text eol=lf
gradlew.bat text eol=crlf

# Nhị phân — không đổi eol, không diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ogg  binary
*.mp3  binary
*.wav  binary
*.jar  binary
*.ttf  binary
*.otf  binary
*.psd  binary
*.ai   binary

# Text asset giữ LF
*.atlas text eol=lf
*.json  text eol=lf
*.proto text eol=lf

# Git LFS cho asset nguồn nặng (GIT-WORKFLOW.md §9)
# Bật sau khi cài git-lfs: chạy `git lfs install` rồi bỏ comment các dòng dưới.
# assets/raw/**            filter=lfs diff=lfs merge=lfs -text
# assets/hyperlap2d-projects/**  filter=lfs diff=lfs merge=lfs -text
