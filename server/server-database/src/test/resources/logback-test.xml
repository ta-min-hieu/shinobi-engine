<?xml version="1.0" encoding="UTF-8"?>
<!-- Chỉ dùng khi chạy test cục bộ để debug Testcontainers/Docker connectivity — bật DEBUG cho
     org.testcontainers/com.github.dockerjava để thấy lý do thật mỗi Docker client strategy fail. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.testcontainers" level="DEBUG"/>
    <logger name="com.github.dockerjava" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
