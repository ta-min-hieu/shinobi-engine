# Copy thành .env.prod (đã bị .gitignore, xem mẫu .gitignore hiện có cho ".env"). KHÔNG commit
# .env.prod (SECURITY.md §13). Dùng cùng `docker compose -f docker-compose.prod.yml --env-file
# .env.prod up -d` — KHÔNG dùng chung file `.env` với docker-compose.yml (dev), tránh lẫn secret.
#
# ⚠️ Đây là password THẬT chạy Production — không phải "change-me-dev-only" như .env.example.
# Sinh ngẫu nhiên đủ mạnh (vd `openssl rand -base64 32`), lưu vào secret manager/password manager,
# KHÔNG tái dùng password đã dùng ở dev/CI. Secret đã lộ (kể cả từng commit nhầm rồi xoá) = phải
# rotate, không chỉ đổi giá trị trong file này (SECURITY.md §13 "Secret đã commit = đã lộ").
DB_PASSWORD=
CACHE_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Tag image server-gateway đã build+push qua CI (ci.yml "docker-build-push") — PIN version cụ thể,
# KHÔNG dùng "latest" (DOCKER.md Technical Decision #3). Xem tag thật tại:
# https://github.com/ta-min-hieu/shinobi-engine/pkgs/container/shinobi-engine%2Fserver-gateway
# Ví dụ: IMAGE_TAG=master-a93be8a (build từ 1 commit master cụ thể) hoặc IMAGE_TAG=0.1.0 (release tag).
IMAGE_TAG=
