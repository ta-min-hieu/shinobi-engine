{
  "title": "Kage - Database",
  "uid": "kage-database",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "HikariCP pool active / pending",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "kage_db_pool_active", "legendFormat": "active", "refId": "A"},
        {"expr": "kage_db_pool_pending", "legendFormat": "pending (chờ)", "refId": "B"}
      ]
    }
  ]
}
