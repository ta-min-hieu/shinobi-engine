<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclude filter (STATIC-ANALYSIS.md §10 — suppress hẹp nhất + có lý do, không suppress
  cả class/module trừ khi lý do áp dụng cho cả class). Mỗi <Match> phải có lý do bằng comment ngay
  trên nó — không suppress không giải thích.
-->
<FindBugsFilter>
    <!-- Code protobuf DO PROTOC TỰ SINH (shared-protocol build/generated/sources/proto — không
         phải viết tay, không thể/không nên "sửa" vì protoc ghi đè lại y hệt lần build sau). Toàn
         bộ generated code nằm TRỰC TIẾP dưới dev.kage.protocol; code viết tay (PacketCodec,
         PacketHeader, ProtocolVersion) nằm ở dev.kage.protocol.wire — regex loại trừ chính xác
         subpackage .wire, không đụng tới code viết tay. -->
    <Match>
        <Class name="~dev\.kage\.protocol\.(?!wire\.).*"/>
    </Match>

    <!-- Test giả lập server bằng ServerSocket thường để verify hành vi reconnect/backoff của
         GameConnection — không phải traffic thật, không liên quan TLS Production. -->
    <Match>
        <Class name="dev.kage.client.core.net.GameConnectionReconnectTest"/>
        <Bug pattern="UNENCRYPTED_SERVER_SOCKET"/>
    </Match>

    <!-- GatewayServerIntegrationTest nói ĐÚNG giao thức dây qua socket thật để verify end-to-end
         (chủ đích, xem javadoc class) — cùng lý do TLS-gap ở GameConnection phía trên, dùng
         java.net.Socket thường vì server thật (GatewayServer) cũng plaintext, không phải lỗi
         riêng của test. -->
    <Match>
        <Class name="dev.kage.server.gateway.GatewayServerIntegrationTest"/>
        <Bug pattern="UNENCRYPTED_SOCKET"/>
    </Match>

    <!-- findFreePort() chỉ mở ServerSocket(0) để LẤY SỐ CỔNG TRỐNG rồi đóng ngay — không bao giờ
         accept() hay truyền dữ liệu, TLS không liên quan. -->
    <Match>
        <Class name="dev.kage.server.gateway.MetricsHttpServerTest"/>
        <Bug pattern="UNENCRYPTED_SERVER_SOCKET"/>
    </Match>

    <!-- SecurityIntegrationTest (OWASP.md §4 — authz/replay/rate-limit/fuzzing thay DAST) nói ĐÚNG
         giao thức dây qua socket thật để tấn công server thật, CÙNG lý do GatewayServerIntegrationTest
         ở trên — server thật (GatewayServer) cũng plaintext khi TLS tắt (TlsConfig.disabled(),
         dùng riêng cho test), không phải lỗi riêng của test này. -->
    <Match>
        <Class name="dev.kage.server.gateway.SecurityIntegrationTest"/>
        <Bug pattern="UNENCRYPTED_SOCKET"/>
    </Match>

    <!-- Fuzz test (shouldNotCrashOrHang_whenReceivingMalformedOrRandomFrames) dùng java.util.Random
         với seed CỐ ĐỊNH CHỦ ĐÍCH — tái lập được khi cần điều tra lại 1 lần fail (xem comment tại
         chỗ khởi tạo). Đây là test tự tấn công server bằng byte rác, KHÔNG phải giá trị bảo mật
         thật (không phải token/khoá) — SecureRandom ở đây chỉ làm test không tái lập được, không
         thêm gì. Cùng tinh thần các exclude PREDICTABLE_RANDOM khác trong file này (AiSystem,
         LootRoller, SimulatedPlayer — random KHÔNG bảo mật thì predictable là lựa chọn ĐÚNG). -->
    <Match>
        <Class name="dev.kage.server.gateway.SecurityIntegrationTest"/>
        <Bug pattern="PREDICTABLE_RANDOM"/>
    </Match>

    <!-- Random chọn hướng tuần tra quái vật (gameplay, KHÔNG bảo mật) — sinh ở server đúng quy tắc
         (CLAUDE.md "Random ảnh hưởng gameplay: chỉ sinh ở server"), predictable PRNG là lựa chọn
         ĐÚNG cho gameplay (SecureRandom lãng phí, không cần thiết cho hướng đi AI). -->
    <Match>
        <Class name="dev.kage.server.world.AiSystem"/>
        <Bug pattern="PREDICTABLE_RANDOM"/>
    </Match>

    <!-- Roll trúng đòn/chí mạng trong combat (gameplay, KHÔNG bảo mật) — sinh ở server đúng quy
         tắc, predictable PRNG đúng cho gameplay damage roll, không cần SecureRandom. -->
    <Match>
        <Class name="dev.kage.server.world.CombatConstants"/>
        <Bug pattern="PREDICTABLE_RANDOM"/>
    </Match>

    <!-- ⚠️ KHÔNG PHẢI false positive — TLS THẬT SỰ CHƯA ĐƯỢC IMPLEMENT ở đây (2026-07-30, phát
         hiện lần đầu khi bật SpotBugs/find-sec-bugs). NETWORK.md liệt "TLS bắt buộc ở Production"
         là Technical Decision Accepted, nhưng chưa có dòng code SslContext/SSLSocket nào trong
         GameConnection HAY GatewayServer (Netty phía server cũng plaintext, find-sec-bugs không
         bắt được vì detector chỉ nhận java.net.Socket, không nhận Netty SocketChannel — kiểm tra
         thủ công xác nhận). Suppress ở ĐÂY chỉ để không chặn build trong lúc chờ quyết định làm
         TLS thật (việc lớn, cần ADR riêng: cert management, SslHandler cả 2 phía, tự ký hay CA
         thật) — KHÔNG suppress vĩnh viễn, xoá <Match> này ngay khi TLS được code thật. -->
    <Match>
        <Class name="dev.kage.client.core.net.GameConnection"/>
        <Bug pattern="UNENCRYPTED_SOCKET"/>
    </Match>

    <!-- EcsWorld là live shared state theo đúng thiết kế ECS (ECS.md) — WorldScreen CẦN giữ tham
         chiếu tới CÙNG 1 world mà game loop đang mutate, defensive-copy ở đây vô nghĩa (sẽ tách rời
         khỏi world thật, WorldScreen sẽ render dữ liệu cũ mãi mãi). -->
    <Match>
        <Class name="dev.kage.client.core.world.WorldScreen"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- So sánh float bằng != có chủ đích: phát hiện "hướng di chuyển đổi so với lần gửi trước" để
         tránh gửi lại lệnh move dư thừa (giảm băng thông) — cả 2 giá trị đến từ CÙNG 1 phép tính
         xác định trên input rời rạc (dirX chỉ nhận -1/0/1), không phải so sánh 2 giá trị trôi dạt
         độc lập. Trường hợp xấu nhất nếu có sai số nổi: gửi thêm 1 gói tin thừa thỉnh thoảng, không
         phải lỗi gameplay. -->
    <Match>
        <Class name="dev.kage.client.core.world.LocalIntentSender"/>
        <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
    </Match>

    <!-- Username mặc định CHỈ dùng khi chạy dev/test không truyền username (2 client cùng máy,
         ROADMAP Phase 3 Exit Criteria) — không phải giá trị bảo mật (không phải token/mật khẩu),
         predictable là chấp nhận được ở đây. -->
    <Match>
        <Class name="dev.kage.client.desktop.DesktopLauncher"/>
        <Bug pattern="PREDICTABLE_RANDOM"/>
    </Match>

    <!-- Cố ý (ECS.md §10, xem javadoc Component.java): interface này là CẦU NỐI DUY NHẤT bọc
         com.badlogic.ashley.core.Component — trùng simple name là thiết kế, không phải nhầm lẫn. -->
    <Match>
        <Class name="dev.kage.engine.ecs.Component"/>
        <Bug pattern="NM_SAME_SIMPLE_NAME_AS_INTERFACE"/>
    </Match>

    <!-- DataSource (HikariCP) / JedisPool (Redis) là tài nguyên hạ tầng dùng chung (connection
         pool), KHÔNG phải value object — giữ tham chiếu trực tiếp là đúng thiết kế (server-database
         là module DUY NHẤT được chạm JDBC/Redis, Điều 23), copy "phòng thủ" vô nghĩa (không thể
         "copy" 1 connection pool). Khớp theo KIỂU field (không phải từng class) vì rất nhiều
         adapter/transaction-runner trong server-database đều giữ 1 trong 2 kiểu này (cú pháp
         <Field type=...> xác nhận đúng qua ví dụ thật killbill/killbill spotbugs-exclude.xml,
         không đoán). -->
    <Match>
        <Or>
            <Field type="javax.sql.DataSource"/>
            <Field type="redis.clients.jedis.JedisPool"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- PacketCodec.Frame.payload là byte[] KHÔNG copy phòng thủ — có chủ đích vì hiệu năng
         (javadoc class đã ghi rõ cạm bẫy equals()): MỌI gói tin mạng đi qua encodeFrame/decodeFrame,
         copy mảng ở đây là allocation thật trong hot path, vi phạm Điều 6/31 (cấm allocation mỗi
         frame). Đánh đổi có chủ đích, không phải sơ suất. -->
    <Match>
        <Class name="dev.kage.protocol.wire.PacketCodec$Frame"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- tools:load-test giả lập client nói ĐÚNG giao thức dây qua socket thật (chủ đích, xem
         javadoc LoadTestRunner) — cùng lý do TLS-gap ở GameConnection: production thật cũng
         plaintext, không phải lỗi riêng của tool đo tải. -->
    <Match>
        <Class name="dev.kage.tools.loadtest.SimulatedPlayer"/>
        <Bug pattern="UNENCRYPTED_SOCKET"/>
    </Match>

    <!-- Random quyết định hành vi giả lập (xác suất chat/ping/auto-target mỗi cycle) — công cụ đo
         tải, không phải gameplay hay bảo mật thật, predictable PRNG hoàn toàn phù hợp. -->
    <Match>
        <Class name="dev.kage.tools.loadtest.SimulatedPlayer"/>
        <Bug pattern="PREDICTABLE_RANDOM"/>
    </Match>

    <!-- So sánh double == 0.5/0.95/0.99 sau khi parse TỪ CHUỖI CỐ ĐỊNH Micrometer luôn ghi y hệt
         ("quantile=\"0.5\"") — Double.parseDouble cho cùng input luôn ra cùng bit pattern như
         literal trong code (cùng thuật toán chuyển decimal->double), không phải so sánh 2 giá trị
         tính toán độc lập có thể trôi dạt. -->
    <Match>
        <Class name="dev.kage.tools.loadtest.MetricsScraper"/>
        <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
    </Match>

    <!-- Clean Architecture Port (docs/templates/feature-module) — MỌI UseCase trong MỌI
         server-features/feature-* giữ tham chiếu tới 1 Port (interface, dependency injection),
         KHÔNG phải value object. Đây là core pattern lặp lại hàng trăm lần xuyên suốt dự án.
         ⚠️ PHÁT HIỆN THẬT: thử khớp theo <Field type="~.*Port"/> TRƯỚC nhưng KHÔNG hoạt động (build
         thật vẫn báo lỗi sau khi thêm — SpotBugs filter <Field type=...> có thể cần định dạng khác
         plain dotted name, không xác nhận được cú pháp đúng do docs 429 lúc tra). Đổi sang khớp
         THEO TÊN CLASS (đã verify class-name regex hoạt động đúng ở entry generated-code phía
         trên) — mọi class `*UseCase` trong package `dev.kage.<feature>.application` (quy ước
         template, không phải đoán). -->
    <!-- Cùng lý do — "*Ports" là record gộp NHIỀU Port để tránh vượt ParameterNumber (vd MailPorts,
         ShopPorts, cùng tinh thần ShutdownContext ở GatewayBootstrap) — cũng chỉ giữ tham chiếu
         Port, không phải value object. -->
    <Match>
        <Class name="~dev\.kage\.[a-z]+\.application\..*(UseCase|Ports)"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Cùng LÝ DO Y HỆT entry ngay trên, chỉ khác tầng: `*Facade` ở `api/` cũng giữ tham chiếu
         Port cho những thao tác không có nghiệp vụ gì ngoài delegation (xem javadoc
         CharacterFacade.characterPort). Defensive-copy một interface DI là vô nghĩa.
         ⚠️ Xuất hiện 2026-08-09 khi thêm addExperience/saveLevel vào CharacterPort — SpotBugs chỉ
         xếp interface vào loại "mutable" (và mới báo EI2) sau khi nó có đủ method ghi; code Facade
         không hề đổi. Tức đây là ngưỡng phân loại của công cụ, không phải lỗi mới sinh ra. -->
    <Match>
        <Class name="~dev\.kage\.[a-z]+\.api\..*Facade"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Roll rơi đồ / cường hoá (gameplay, KHÔNG bảo mật) — sinh ở server đúng quy tắc
         (ENGINE.md §10, javadoc class), predictable PRNG đúng cho gameplay, không cần SecureRandom. -->
    <Match>
        <Class name="dev.kage.inventory.domain.LootRoller"/>
        <Bug pattern="PREDICTABLE_RANDOM"/>
    </Match>
    <Match>
        <Class name="dev.kage.inventory.application.EnhanceItemUseCase"/>
        <Bug pattern="PREDICTABLE_RANDOM"/>
    </Match>

    <!-- InventorySnapshot (ADR-035 Decision-1) là ẢNH CHỤP đọc-một-lần: use-case dựng nó, gateway
         đọc xong rồi vứt, không ai giữ lại. SpotBugs báo EI/EI2 vì record ôm hai aggregate có
         method ghi (Inventory/Equipment) — đúng theo định nghĩa công cụ, nhưng defensive-copy ở đây
         mua đúng con số không: bản sao cũng lỗi thời ngay khi transaction kế tiếp chạy, và giá trị
         của gói tin nằm ở chỗ nó là ảnh chụp tại MỘT thời điểm chứ không phải một view sống. -->
    <Match>
        <Class name="dev.kage.inventory.domain.InventorySnapshot"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Fake*Port trong test là test double (capture tham chiếu để assert lại) — không phải state
         thật cần bảo vệ, defensive-copy vô nghĩa trong test fake. Khớp mọi nested Fake*Port bên
         trong class Test (cùng lý do sẽ lặp lại ở feature khác dùng cùng pattern test double). -->
    <Match>
        <Class name="~.*Test\$Fake.*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Prefix truyền cho Files.createTempDirectory() là hằng số ghép từ tên enum GraphicsTier
         (LOW/MEDIUM/HIGH) trong chính code, KHÔNG phải input người dùng — find-sec-bugs
         (PATH_TRAVERSAL_IN) không phân biệt được "String ghép từ đâu", chỉ thấy signature API
         nhận String nên báo bảo thủ cho MỌI lời gọi createTempDirectory bất kể nguồn. tools/*
         chạy build-time trên máy dev/CI, không nhận input từ người dùng cuối. -->
    <Match>
        <Class name="dev.kage.tools.assetpipeline.AssetPipelineRunner"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>

    <!-- PlayContext gộp EcsWorld+InputMapper cho chuỗi màn hình Login → CharacterSelect → World
         (CODING-STANDARDS ParameterNumber max=4, xem javadoc class) — CÙNG lý do exclude EcsWorld
         ở WorldScreen phía trên: cả 2 field là live shared singleton (world game loop đang mutate,
         input source platform-specific), không phải value object, defensive-copy vô nghĩa. -->
    <Match>
        <Class name="dev.kage.client.core.world.PlayContext"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- LoginScreen/CharacterSelectScreen giữ tham chiếu KageEngine để gọi engine.setScreen(...)
         chuyển màn hình tiếp theo (xem javadoc mỗi class) — composition-root singleton dùng cho
         điều hướng, CÙNG bản chất "giữ tham chiếu DI, không phải value object" như *UseCase/*Ports
         phía trên, chỉ khác domain (UI screen thay vì server use case). -->
    <Match>
        <Class name="~dev\.kage\.client\.core\.screen\.(LoginScreen|CharacterSelectScreen)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- CombatHud.stage() lộ ra CÓ CHỦ ĐÍCH — WorldScreen cần đúng instance Stage đó để
         Gdx.input.setInputProcessor(combatHud.stage()) (xem javadoc CombatHud + WorldScreen#show).
         Stage Scene2D là live mutable UI scene, không phải value object, "copy phòng thủ" một Stage
         là vô nghĩa (không thể clone GL resource + actor tree, và bản copy sẽ tách khỏi input thật). -->
    <Match>
        <Class name="dev.kage.client.core.ui.hud.CombatHud"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- DialoguePanel.stage() — y hệt CombatHud ngay trên, và cùng một lý do: WorldScreen phải đưa
         Stage vào InputMultiplexer (khung hội thoại nuốt click TRƯỚC HUD, xem javadoc DialoguePanel).
         Cũng lộ KageSkin nhận từ constructor: đó là CHO MƯỢN có chủ đích, sở hữu vẫn ở CombatHud. -->
    <Match>
        <Class name="dev.kage.client.core.ui.hud.DialoguePanel"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- ChatPanel.stage() — lần thứ ba cùng một lý do (CombatHud, DialoguePanel ngay trên):
         WorldScreen phải đưa đúng instance Stage đó vào InputMultiplexer để đặt thứ tự nuốt input,
         thứ chỉ đặt được cho cả một Stage chứ không cho một actor bên trong (xem javadoc ChatPanel
         + WorldScreen#buildInputProcessor). Stage Scene2D là live mutable UI scene, không phải value
         object. Ba lần lặp lại nhưng vẫn giữ 3 <Match> riêng thay vì gộp regex: STATIC-ANALYSIS.md
         §10 đòi suppress HẸP NHẤT, và một regex `~.*Panel|Hud` sẽ tự động tha cho mọi widget HUD
         viết sau này mà không ai kịp nhìn lại. -->
    <Match>
        <Class name="dev.kage.client.core.ui.hud.ChatPanel"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- PartyPanel.stage() — cùng lý do ChatPanel/DialoguePanel/CombatHud ngay trên: WorldScreen phải
         đưa đúng instance Stage đó vào InputMultiplexer để đặt thứ tự nuốt input (cửa sổ Nhóm che
         giữa màn hình nên phải nuốt click TRƯỚC chat và HUD), thứ chỉ đặt được cho cả một Stage. -->
    <Match>
        <Class name="dev.kage.client.core.ui.hud.PartyPanel"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- FriendPanel.stage() — lần thứ tư cùng một lý do (CombatHud, DialoguePanel, ChatPanel ngay
         trên): WorldScreen phải đưa đúng instance Stage đó vào InputMultiplexer để đặt thứ tự nuốt
         input, thứ chỉ đặt được cho cả một Stage chứ không cho một actor bên trong (xem javadoc
         FriendPanel + WorldScreen#buildInputProcessor). Cửa sổ bạn bè còn cần thứ tự đó hơn cả:
         nó đứng TRƯỚC ChatPanel để nuốt phím trong lúc người chơi đang gõ tên. Vẫn giữ <Match>
         riêng thay vì gộp regex, cùng lý do đã ghi ở entry ChatPanel. -->
    <Match>
        <Class name="dev.kage.client.core.ui.hud.FriendPanel"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- GuildPanel.stage() — lần thứ tư cùng một lý do (CombatHud, DialoguePanel, ChatPanel ngay
         trên): WorldScreen phải đưa đúng instance Stage đó vào InputMultiplexer để đặt thứ tự nuốt
         input, thứ chỉ đặt được cho cả một Stage chứ không cho một actor bên trong (xem javadoc
         GuildPanel + WorldScreen#buildInputProcessor). Cũng lộ KageSkin nhận từ constructor: CHO
         MƯỢN có chủ đích, sở hữu vẫn ở CombatHud — cùng lý do DialoguePanel. Vẫn giữ <Match> riêng
         thay vì gộp regex, cùng lập luận đã ghi ở ChatPanel. -->
    <Match>
        <Class name="dev.kage.client.core.ui.hud.GuildPanel"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- DuelPanel.stage() — lần thứ sáu cùng một lý do (CombatHud, DialoguePanel, ChatPanel,
         FriendPanel, GuildPanel ngay trên): WorldScreen phải đưa đúng instance Stage đó vào
         InputMultiplexer để đặt thứ tự nuốt input, thứ chỉ đặt được cho cả một Stage chứ không cho
         một actor bên trong (xem javadoc DuelPanel + WorldScreen#buildInputProcessor). Vẫn giữ
         <Match> riêng thay vì gộp regex, cùng lập luận đã ghi ở ChatPanel. -->
    <Match>
        <Class name="dev.kage.client.core.ui.hud.DuelPanel"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- FactionPanel.stage() — lần thứ bảy cùng một lý do (CombatHud, DialoguePanel, ChatPanel,
         PartyPanel/FriendPanel/GuildPanel ngay trên): WorldScreen phải đưa đúng instance Stage đó
         vào InputMultiplexer để đặt thứ tự nuốt input, thứ chỉ đặt được cho cả một Stage chứ không
         cho một actor bên trong (xem javadoc FactionPanel + WorldScreen#buildInputProcessor). Vẫn
         giữ <Match> riêng thay vì gộp regex, cùng lập luận đã ghi ở ChatPanel. -->
    <Match>
        <Class name="dev.kage.client.core.ui.hud.FactionPanel"/>
