<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Checkstyle cho TEST SOURCE — giống checkstyle.xml, CHỈ khác HAI chỗ:
  1. MethodName: cho phép dấu gạch dưới để mô tả hành vi (TESTING.md §10:
     "shouldRejectAttack_whenTargetOutOfRange" — chính tài liệu của dự án khuyến nghị quy ước này cho
     test, khác production code).
  2. KHÔNG có MethodLength. Rà 2026-10-03: file này từ ngày đầu (Phase 2) đã thiếu LẶNG LẼ ba rule
     (hậu tố Manager/Helper/Util/Info/Data, MethodLength, ParameterNumber) trong khi dòng đầu vẫn ghi
     "chỉ khác MethodName". Hai rule kia bật lại không lộ vi phạm nào. MethodLength thì lộ 50 hàm test
     dài hơn 50 dòng (server-gateway 42, server-database 4, client-core 3, server-world 1) — phần lớn là
     fake*Facade dựng test double và kịch bản end-to-end qua socket thật. Tách nhỏ chúng là việc thật,
     không cơ học, nên đang CHỜ CHỦ DỰ ÁN: giữ ngoại lệ này hay trả nợ rồi bật lại.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="RegexpSingleline">
        <property name="format" value="^import .*\.\*;$"/>
        <property name="message" value="Cấm wildcard import — liệt kê rõ từng import (CODING-STANDARDS §23)."/>
    </module>

    <module name="RegexpSingleline">
        <property name="format" value="\b(class|interface|record|enum)\s+\w*(Manager|Helper|Util|Utils|Info|Data)\b"/>
        <property name="message" value="Hậu tố Manager/Helper/Util/Info/Data thường vô nghĩa — đặt tên theo trách nhiệm thật (CODING-STANDARDS §2). Nếu thật sự phản ánh trách nhiệm, suppress có lý do."/>
    </module>

    <!-- Cấm `var` cho local variable (CODING-STANDARDS §5) — luôn ghi kiểu tường minh, kể cả trong test.
         Ngoại lệ cú pháp bắt buộc thật sự (hiếm) → suppress bằng @SuppressWarnings("checkstyle:NoVarLocal")
         trên method/class bao quanh, kèm comment giải thích lý do ngay tại dòng var. -->
    <module name="RegexpSingleline">
        <property name="id" value="NoVarLocal"/>
        <property name="format" value="(^|[\s(;])var\s+[A-Za-z_$][A-Za-z0-9_$]*\s*[=:]"/>
        <property name="message" value="Cấm `var` cho local variable — ghi rõ kiểu tường minh (CODING-STANDARDS §5). Nếu var thật sự bắt buộc về cú pháp, suppress bằng @SuppressWarnings(&quot;checkstyle:NoVarLocal&quot;) kèm comment giải thích lý do."/>
    </module>

    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^\s*//.*https?://"/>
    </module>

    <module name="TreeWalker">
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <module name="TypeName"/>
        <!-- Khác bản main: cho phép "should...When...", "given...Should..." kèm dấu "_" (TESTING.md §10). -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="ConstantName"/>
        <module name="PackageName">
            <property name="format" value="^dev\.kage(\.[a-z][a-z0-9]*)+$"/>
        </module>

        <!-- MethodLength (≤50 dòng) KHÔNG áp cho test — xem ghi chú đầu file. -->
        <module name="ParameterNumber">
            <property name="max" value="4"/>
            <property name="ignoreOverriddenMethods" value="true"/>
        </module>

        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>
        <module name="EqualsHashCode"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

        <module name="SuppressWarningsHolder"/>
    </module>

    <module name="SuppressWarningsFilter"/>
</module>
